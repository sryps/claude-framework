#!/usr/bin/env bash
# Run scripts/security-check.sh --changed before each push.
# Advisory by default: findings are printed and the push goes ahead.
# Set FW_ENFORCE=1 in your environment to make findings stop the push.
root=$(git rev-parse --show-toplevel) || exit 0
[ -f "$root/scripts/security-check.sh" ] || exit 0
bash "$root/scripts/security-check.sh" --changed && exit 0
if [ "${FW_ENFORCE:-}" = 1 ]; then
  echo "security-check failed. The push is stopped (FW_ENFORCE=1)." >&2
  exit 1
fi
echo "security-check found problems (above). The push goes ahead; fix them before review." >&2
exit 0
