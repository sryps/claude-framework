{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "ask": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.mobileprovision)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/service-account*.json)",
      "Read(**/google-services*.json)",
      "Read(**/GoogleService-Info*.plist)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.claude/settings*.json)",
      "Edit(**/.git/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * HEAD:master)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(gh pr merge*)",
      "Bash(gh release create*)",
      "Bash(gh secret*)",
      "Bash(sudo *)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(cargo publish*)",
      "Bash(docker push*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)"
    ]
  }
}
